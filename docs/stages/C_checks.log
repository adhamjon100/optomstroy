import re
data=open('coverage/lcov.info',encoding='utf-8').read().split('end_of_record')
for rec in data:
    m=re.search(r'SF:(.*)',rec)
    if not m: continue
    f=m.group(1).replace(chr(92),'/')
    if not re.search(r'lib/core/(utils|error)/',f): continue
    lf=int(re.search(r'LF:(\d+)',rec).group(1)); lh=int(re.search(r'LH:(\d+)',rec).group(1))
    bf=re.search(r'BRF:(\d+)',rec); bh=re.search(r'BRH:(\d+)',rec)
    br=f' branches {bh.group(1)}/{bf.group(1)}' if bf and int(bf.group(1)) else ''
    print(f'{f.split(\"lib/\")[-1]}: lines {lh}/{lf}{br}')
"
