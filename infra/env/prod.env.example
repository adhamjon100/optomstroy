# prod.env.example — шаблон .env РАБОЧЕГО контура на сервере заказчика (infra/compose.prod.yml; 16 §4.3, §14.1 шаг 8).
# Набор имён — тот же, что в /.env.example (канонический перечень 16 §4.3, без «R2 и условных»), плюс параметры уровня
# compose (раздел «Уровень compose» в конце: Caddyfile общего caddy и память сервисов; BACKUP_PITR — в разделе
# копий: её читают postgres и сервис backup, но не pos-api). Значения — безопасные для
# первого запуска рабочего контура. Тестовая копия (16 §11) — этот же шаблон + замены infra/env/test.env.example.
# Здесь ТОЛЬКО несекретная конфигурация. Секреты — файлы secrets/* (640, группа optomstroy-secrets); указатели *_FILE
# заданы в compose-файлах. install.sh копирует этот файл в /opt/optomstroy/prod/.env (права 600) и заполняет
# API_TAG, BACKUP_TAG, PUBLIC_BASE_URL, MIN_APP_VERSION, JWT_KEY_ID, CADDY_SITE_ADDRESS, CADDY_TLS из параметров.
# Пустое значение у переменной с пометкой «обязательна» — install.sh остановится и назовёт её (без значений).
# ФОРМАТ: у пустой переменной комментарий — ОТДЕЛЬНОЙ строкой выше, сама строка — «ИМЯ=». Compose (compose-go) читает
# `ИМЯ=   # текст` как значение «# текст», а не пусто (install.sh/update.sh такие строки исправляют и не пропускают).
# Сверка имён и формата: python -I -X utf8 infra/docker/scripts/check_compose_prod.py infra/compose.prod.yml

# --- Общие и платформа ---
APP_ENV=prod                          # рабочий контур; compose.prod.yml дополнительно закрепляет prod (OPS-027)
# обязательна: неизменяемый тег optomstroy/api (не latest); заполняет install.sh/update.sh
API_TAG=
# обязательна: неизменяемый тег optomstroy/backup; заполняет install.sh/update.sh
BACKUP_TAG=
# обязательна: https://api.<домен> (Q-032); заполняет install.sh из --domain
PUBLIC_BASE_URL=
LOG_LEVEL=info                        # debug/trace при prod — отказ в старте (SEC-061)
TZ=Asia/Bishkek
WORKERS_ENABLED=false                 # D-45: в сервисе worker переопределяется на true (compose)
APP_READ_ONLY=false                   # true — режим сдерживания инцидента (503 APP_READ_ONLY; RUNBOOK §9)
OPENAPI_PUBLIC=false                  # true при prod — отказ в старте (08 §4.19.2)
# обязательна: android=X.Y.Z,windows=X.Y.Z; install.sh берёт версию из pos-app/pubspec.yaml
MIN_APP_VERSION=
# тот же формат; пусто — заголовок X-Recommended-App-Version не отправляется
RECOMMENDED_APP_VERSION=
CUSTOMER_SELF_SERVICE=true            # ядро §24.2: регистрация клиентов, режим клиента в R1; только env
KIOSK_MODE=false                      # планшет магазина: true — только по письменному разрешению заказчика (DEPLOY-053)
# необязательная: IP/CIDR сети магазина через запятую; пусто — проверки нет
KIOSK_ALLOWED_CIDRS=
RECEIVABLES_MAX_AGE_MIN=60

# --- База данных ---
POSTGRES_USER=optomstroy_prod         # суперпользователь образа postgres (инициализация, обслуживание); не роль приложения
POSTGRES_DB=optomstroy_prod           # после первого запуска не менять: database_url и каталог данных уже созданы

# --- Аутентификация, OTP, PIN ---
# обязательна: kid активного ключа; install.sh ставит prod-<ГГГГММДД>, ротация — RUNBOOK §7
JWT_KEY_ID=
OTP_HMAC_SECRET_VERSION=1             # меняет только infra/scripts/rotate-secret.sh otp-pepper
PIN_PEPPER_VERSION=1                  # меняет только infra/scripts/rotate-secret.sh pin-pepper
SESSION_IDLE_LOCK_MINUTES=30
AUTH_OTP_TEST_MODE=false              # true при prod — отказ в старте (OPS-027)
# при prod — только пусто (OPS-027)
AUTH_OTP_TEST_PHONES=
# при prod — только пусто (OPS-027)
AUTH_OTP_TEST_CODE=
OTP_GLOBAL_PER_MIN=60
OTP_PROVIDER=internal                 # internal | smspro (smspro — только R2, Q-242)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_15M=3
OTP_MAX_SENDS_PER_PHONE_24H=10
OTP_MAX_SENDS_PER_IP_10M=20
OTP_MAX_SENDS_PER_IP_24H=100
OTP_MAX_SENDS_PER_DEVICE_10M=5
OTP_MAX_SENDS_PER_DEVICE_24H=20
OTP_LOCK_AFTER_LOCKED_CODES=3
OTP_PHONE_PAUSE_MINUTES=30
OTP_RESEND_ON_DLR_FAILED=true
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_STAFF_DAYS=7
AUTH_REFRESH_TTL_CUSTOMER_DAYS=30
AUTH_REFRESH_TTL_KIOSK_DAYS=180       # планшет магазина: 180 дней с подключения (Р-22 (а))
AUTH_REFRESH_IDLE_STAFF_HOURS=24
AUTH_REFRESH_IDLE_CUSTOMER_DAYS=14
AUTH_REFRESH_IDLE_KIOSK_DAYS=7        # планшет магазина: 7 дней без связи (Р-22 (а))
AUTH_REFRESH_GRACE_SECONDS=30
AUTH_BACKGROUND_LOCK_MINUTES=5
AUTH_BIO_AUTO_PROMPT=true
AUTH_BIO_ALLOW_WEAK=off               # уровень W Android (ADR-116): не off — только после записи T-BIO-026 (DEPLOY-055)
AUTH_BIO_WEAK_REAUTH_HOURS=24         # уровень W: PIN или вход по SMS не реже раза в N часов; 1…24
AUTH_WINDOWS_HELLO_KEY=off            # ключ Windows Hello без PIN (ADR-116, W2): не off — только после T-BIO-031; all — только письменно
AUTH_NOTIFY_OLD_PHONE=false           # Q-038 (платная SMS)
PIN_MIN_LENGTH_STAFF=6
PIN_MAX_ATTEMPTS=5

# --- SMSPro (логин и пароль — файлы secrets/smspro_login, secrets/smspro_password; вводит человек заказчика) ---
SMS_PROVIDER=smspro                   # fake при prod — отказ в старте (OPS-027)
SMSPRO_BASE_URL=https://smspro.nikita.kg/api
# имя отправителя, согласованное с SMSPro (Q-029); install.sh предупредит, если пусто
SMSPRO_SENDER=
SMSPRO_TEST_FLAG=false                # true при prod — отказ в старте
SMSPRO_TIMEOUT_MS=15000
SMSPRO_RETRY_MAX=3
SMSPRO_DLR_MODE=poll                  # push — только вместе с SMSPRO_DLR_ALLOWED_IPS (16 §4.6)
SMSPRO_BALANCE_POLL_MINUTES=15
SMSPRO_BALANCE_ALERT_SOM=300
SMSPRO_CB_OPEN_MINUTES=5
SMSPRO_DEF_PRECHECK=false
SMS_OTP_TEMPLATE="Kod: {code}. Optomstroy"   # текст — Q-029; ровно одна часть SMS; без {code} — отказ в старте

# --- Регистрация, приглашения ---
INVITATION_TTL_DAYS=30                # Q-141
INVITE_SMS=false
REGISTRATION_SECOND_OTP=false

# --- 1С (учётные данные — файлы secrets/onec_*, дополнения compose.prod.onec*.yml; RUNBOOK §8) ---
# Первый запуск — по 16 §4.3 и §14.1 шаг 8: основной путь extension. Пока 1С не подключена (до приёмки API
# программиста 1С), ONEC_BASE_URL пуст: сервер стартует, синхронизация сообщает об ошибке конфигурации (RUNBOOK §8.1).
# Рабочий запуск магазина — только с подключённой 1С (1С — главная система; 15 ADR-120).
ONEC_MODE=extension                   # extension (основной) | odata_only (запасной); fixtures при prod — отказ в старте
# https://<хост 1С>/<база> (Q-031); пусто — 1С не подключена
ONEC_BASE_URL=
ONEC_ODATA_PATH=odata/standard.odata
# hs/<имя> (05_ONEC_INTEGRATION)
ONEC_HS_PATH=
ONEC_TIMEOUT_MS=30000
ONEC_SYNC_CHECK_TIMEOUT_MS=6000       # R0 §19.2
ONEC_SYNC_PAGE_SIZE=1000
ONEC_MAX_CONCURRENCY=2
ONEC_ODATA_WRITE_ENABLED=false
ONEC_INBOUND_ENABLED=false            # true только в сценарии C-2 и только при ONEC_MODE=extension (16 §4.6)
MANUAL_ORDER_SLA_MIN=60               # Q-119

# --- Синхронизация (значения по умолчанию; переопределение — app_settings.sync_interval.<entity>) ---
SYNC_STOCK_CRON="*/10 * * * *"
SYNC_PRICES_CRON="*/15 * * * *"
SYNC_ORDER_STATUS_CRON="*/5 * * * *"
SYNC_MASTER_CRON="*/30 * * * *"
SYNC_IMAGES_CRON="30 2 * * *"
SYNC_RECONCILE_CRON="0 4 * * 0"
SYNC_NIGHT_WINDOW=01:00-06:00
SALES_HISTORY_MONTHS=12
SYNC_COUNT_CHECK_CRON="30 3 * * *"    # не пересекается с BACKUP_SCHEDULE (05:30)
SYNC_ALERT_UNREACHABLE_MIN=10         # 05 SYNC-038
OUTBOX_MAX_ATTEMPTS=20                # ядро §22.1 (Q-176)
OUTBOX_MAX_AGE_HOURS=24               # ядро §22.1 (Q-176)

# --- Платежи, долги, возвраты ---
DEBT_PAYMENTS_FROM_POS=false          # Q-152
RETURNS_FROM_POS_ENABLED=false        # только outbox заявок на возврат в 1С (ядро §21 п.1)
QR_PROVIDER=none                      # onec — только после приёмки методов QR API 1С (16 §14.1 шаг 8, DEPLOY-051); bakai — R2
QR_ONEC_POLL_SECONDS=5                # действует только при QR_PROVIDER=onec
QR_TTL_MINUTES=15
QR_WEBHOOK_ENABLED=false              # true — только QR_PROVIDER=bakai (R2); иначе отказ в старте (11 SEC-135)

# --- Фото ---
MEDIA_DIR=/data/media
MEDIA_MAX_SOURCE_PX=1600

# --- Резервное копирование (сервис backup; 16 §8; RUNBOOK §4) ---
BACKUP_KEEP_DAYS=30                   # ежедневные копии, суток; первая копия месяца — ещё 93 суток (3 месячные, OPS-001)
# КОРЕНЬ внешнего хранилища rclone, например offsite:optomstroy/prod (backup.sh пишет в db/, monthly/, media/,
# caddy_data/); пусто — без внешней копии, а она обязательна (16 §8.1, RUNBOOK §4.3)
BACKUP_REMOTE=
# После ночных заданий синхронизации (SYNC_IMAGES_CRON 02:30, SYNC_COUNT_CHECK_CRON 03:30, SYNC_RECONCILE_CRON вс 04:00)
# и до открытия магазина; сдвигать вместе с ними (Q-033 — согласовать)
BACKUP_SCHEDULE="30 5 * * *"
# обязательна: публичный ключ age (age1...); приватный ключ — НЕ на сервере (OPS-004)
BACKUP_AGE_RECIPIENT=
# Непрерывная копия WAL и восстановление на момент времени (PITR): on | off. В базе POS — заказы, оплаты и возвраты,
# ещё не доставленные в 1С (очередь onec_outbox), сессии и аудит: 15 ADR-035 (дополнение); 16 §8.1 «RPO при PITR
# ≤ 15 мин» (OPS-006, Q-033 — включение по решению заказчика; документ заказчику обещает «не больше 15 минут»). Уровень compose:
# archive_mode у postgres и цикл WAL сервиса backup; смена — `bin/dc up -d postgres backup` (RUNBOOK §4.8)
BACKUP_PITR=on

# --- Уровень compose (приложение не читает; общий caddy проекта optomstroy-edge и память сервисов) ---
# обязательна: имя сайта рабочего контура без схемы, например api.<домен>; заполняет install.sh из --domain
CADDY_SITE_ADDRESS=
# обязательна: e-mail для ACME (Let's Encrypt); заполняет install.sh из --acme-email
CADDY_TLS=
# имя сайта тестовой копии (api-test.<домен>); пусто — сайта теста нет; заполняет install.sh --contour test (16 §11)
CADDY_TEST_SITE_ADDRESS=
# Память (16 §4.4 прим. 2). Пусто — значения для 8 GB: shared_buffers 1GB, лимиты postgres 2G, api 1G, worker 1G.
# На сервере меньше 7,5 ГБ install.sh/update.sh ставят профиль 4 GB: 512MB, 1536M, 768M, 768M. Правка — здесь,
# затем bin/dc up -d postgres api worker; комплект при обновлении эти значения не меняет.
PG_SHARED_BUFFERS=
PG_MEM_LIMIT=
API_MEM_LIMIT=
WORKER_MEM_LIMIT=
