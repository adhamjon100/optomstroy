# test.env.example — ЗАМЕНЫ для .env тестовой копии на сервере заказчика (16 §11; infra/compose.staging.yml).
# `install.sh --contour test` создаёт /opt/optomstroy/test/.env из prod.env.example и заменяет в нём строки ниже
# целиком (остальные значения — как в рабочем шаблоне); при обновлении (update.sh) и повторной установке новые имена
# берутся из prod.env.example, и к ним применяются замены отсюда (lib.sh env_apply_test_for_added); заданные значения
# не меняются.
# Только имена из prod.env.example (сверяет check_compose_prod.py); значений секретов здесь нет.
# Заполняет install.sh: API_TAG, BACKUP_TAG, PUBLIC_BASE_URL (https://<--domain>), CADDY_SITE_ADDRESS (<--domain>),
# MIN_APP_VERSION, JWT_KEY_ID (test-<ГГГГММДД>), BACKUP_AGE_RECIPIENT, AUTH_OTP_TEST_PHONES (--test-phones),
# AUTH_OTP_TEST_CODE (шесть случайных цифр; смотреть — в .env тестовой копии, в журнал не печатается).

APP_ENV=staging                       # закреплён и в compose.staging.yml (16 §11)
POSTGRES_USER=optomstroy_test
POSTGRES_DB=optomstroy_test
LOG_LEVEL=info
SMS_PROVIDER=fake                     # SMS не отправляются; учётные данные SMSPro рабочего контура не копируются (16 §11)
AUTH_OTP_TEST_MODE=true               # вход только номерам AUTH_OTP_TEST_PHONES с кодом AUTH_OTP_TEST_CODE (09 §5.8)
# номера сотрудников для проверок через запятую (+996…); «*» запрещено (ADR-109); задаёт install.sh --test-phones
AUTH_OTP_TEST_PHONES=
# шесть цифр; создаёт install.sh тестового контура
AUTH_OTP_TEST_CODE=
# только ТЕСТОВАЯ копия базы 1С (своя публикация); рабочая 1С — никогда (16 §11); пусто — 1С не подключена
ONEC_BASE_URL=
QR_PROVIDER=none
KIOSK_MODE=false
BACKUP_KEEP_DAYS=7                    # копии теста — только локальные (16 §11: бэкапы теста не требуются)
# пусто: тестовая копия наружу не выгружается
BACKUP_REMOTE=
BACKUP_SCHEDULE="45 5 * * *"          # после копии рабочего контура (05:30)
BACKUP_PITR=off                       # непрерывная копия WAL тестовой копии не нужна (16 §11); включение — RUNBOOK §4.8
# у тестовой копии сайта на общем caddy нет своего «теста»
CADDY_TEST_SITE_ADDRESS=
# сертификат выпускает общий caddy по e-mail рабочего контура
CADDY_TLS=
PG_SHARED_BUFFERS=128MB               # меньшие лимиты (16 §11: postgres 512M, api 512M, worker 512M)
PG_MEM_LIMIT=512M
API_MEM_LIMIT=512M
WORKER_MEM_LIMIT=512M
