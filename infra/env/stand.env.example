# stand.env.example — профиль тестового стенда `optomstroy-test` на Windows-комплекте (ADR-125; P-004 раздел D).
# Применяет infra/windows/scripts/install.ps1 -Stand (контур test): настройки собираются слоями
#   prod.env.example → test.env.example → ЭТОТ ФАЙЛ (последним), затем — параметры install.ps1.
# В пакете — scripts\templates\stand.env.example (build-release.ps1). Только несекретные значения: секретов здесь
# нет и быть не должно (секреты — файлы secrets\*, указатели *_FILE пишет install.ps1; scripts/check_secrets.py).
# Пустое значение = «не задано». Комментарий у пустой переменной — строкой выше (формат infra/env/README.md).
#
# Режимы стенда (ADR-125 п. 4): APP_ENV=staging; 1С — фикстуры (API 1С ещё нет); QR — песочница банка через наш сервер
# (ADR-123); SMS — тестовый режим без трат (ADR-124): SMS не отправляются, вход — только тестовые номера с кодом
# AUTH_OTP_TEST_CODE (шесть случайных цифр, создаёт install.ps1 в config\api.env; общеизвестный код демо 246810 при
# APP_ENV=staging — отказ в старте). Данные — только вымышленные (ADR-119).

APP_ENV=staging
# Временное имя до домена заказчика (ADR-125 п. 2): постоянное — https://api-test.optomstroy.kg [ПРЕДЛОЖЕНИЕ];
# сертификат для имени — у Apache заказчика (Q-384). Другое имя — параметр install.ps1 -PublicBaseUrl.
PUBLIC_BASE_URL=https://api-test.37.114.51.144.sslip.io

# --- 1С: фикстуры (05 ONEC-023), без сети; рабочая 1С — никогда (16 §11) ---
ONEC_MODE=fixtures
# адрес 1С на стенде не задаётся (фикстуры)
ONEC_BASE_URL=
ONEC_INBOUND_ENABLED=false
#
# 1С через HTTP-сервис ОС_API шлюза (ADR-126), только чтение: каталог, цены, остатки, проверка связи, фото. Включает
# install.ps1 -Stand -StandOnecOsApi <корень публикации, например http://localhost/uk_main_fr> — НЕ этот файл: он пишет
# в config\api.env и config\worker.env ONEC_MODE=os_api, ONEC_BASE_URL=<корень публикации>, ONEC_OSAPI_PATH=hs/os/api/v1
# и запоминает адрес в config\install.json. Вход — Basic пользователя шлюза: secrets\onec_user и secrets\onec_password
# (ONEC_USER_FILE / ONEC_PASSWORD_FILE) кладёт import-onec-credentials.ps1 из ONEC_API_USER / ONEC_API_PASSWORD шлюза.
# Необязательные имена там же (пусто = по умолчанию программы): ONEC_OSAPI_PRICE_TYPES (UUID видов цен через запятую;
# пусто — все не удалённые), ONEC_OSAPI_WAREHOUSES (UUID складов; пусто — все), ONEC_OSAPI_POLL_SECONDS (300).
# Запись в 1С (заказы, покупатели) через ОС_API не делается. Обратно на фикстуры: -StandOnecOsApi fixtures.
# Включать — только после письменного ответа на 14 Q-388 (uk_main_fr — тестовая база) и «да» пользователя (16 §3.6);
# до этого стенд на фикстурах. Перед откатом (rollback.ps1) на версию без os_api — сначала -StandOnecOsApi fixtures.

# --- QR: напрямую от банка через наш сервер, песочница банка (ADR-123); банк — [НЕ ПОДТВЕРЖДЕНО: Q-381] ---
QR_PROVIDER=bank
BANK_QR_ADAPTER=sandbox
QR_WEBHOOK_ENABLED=false

# --- SMS: тестовый режим без трат (ADR-124 п. 3–4) ---
SMS_PROVIDER=fake                     # SMS не отправляются; учётных данных SMSPro на стенде нет
SMSPRO_TEST_FLAG=true                 # на случай перевода стенда на smspro до «да» пользователя: <test>1</test>, без отправки
AUTH_OTP_TEST_MODE=true               # вход только номерам AUTH_OTP_TEST_PHONES с кодом AUTH_OTP_TEST_CODE (09 §5.8)
# вымышленные тестовые номера +99670000000x (ADR-119, ADR-124); номер первого администратора — из этого списка;
# -TestPhones install.ps1 заменяет список
AUTH_OTP_TEST_PHONES=+996700000001,+996700000002,+996700000003,+996700000004,+996700000005
# шесть цифр — создаёт install.ps1 (случайные); не 246810
AUTH_OTP_TEST_CODE=
SMSPRO_CB_OPEN_MINUTES=1              # запрос кода на номер вне списка закрывает выдачу кодов на 1 мин (README §7)
#
# Настоящая SMS на стенде (ADR-124 п. 5) — ТОЛЬКО после того, как заказчик сам положит secrets\smspro_login и
# secrets\smspro_password (Q-385), и после письменного «да» пользователя на конкретную отправку (Q-235). Тогда в
# config\api.env и config\worker.env (не здесь): SMS_PROVIDER=smspro, AUTH_OTP_TEST_MODE=false, AUTH_OTP_TEST_CODE и
# AUTH_OTP_TEST_PHONES — пусто (иначе отказ в старте), SMSPRO_SENDER=<согласованное имя>, SMSPRO_TEST_FLAG=false,
# SMS_STAGING_ALLOWED_PHONES=<номера, на которые разрешена настоящая отправка> — остальным уходит <test>1</test>
# (09 §5.8). Порядок — infra/windows/README.md §7.1.
