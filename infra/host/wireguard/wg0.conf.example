# /etc/wireguard/wg0.conf на сервере POS — сценарий C-1 «туннель инициирует магазин»: сервер вне магазина (дата-центр),
# 1С в магазине (16 §3.3, §12.2; DEPLOY-020, DEPLOY-035; 16 §4.3 строка «WG_* (только C-1)» — уровень хоста, вне
# compose). ШАБЛОН: ключей и реальных адресов нет. Процедура — docs/ops/RUNBOOK.md §11.
#
# Установка (DevOps, шаг 1 плана 16 §14.1, только по письменному разрешению заказчика; RUNBOOK §11.2):
#   apt-get install -y wireguard-tools
#   install -d -m 700 /etc/wireguard
#   ( umask 077; wg genkey > /etc/wireguard/server.private )      # приватный ключ: не печатать, не копировать
#   wg pubkey < /etc/wireguard/server.private > /etc/wireguard/server.public   # открытый — передаётся магазину
#   install -m 600 -o root -g root infra/host/wireguard/wg0.conf.example /etc/wireguard/wg0.conf   # заменить все <…>
#   systemctl enable --now wg-quick@wg0 && wg show wg0
# Приватный ключ лежит отдельным файлом и подставляется в PostUp (пример wg-quick(8)), поэтому в wg0.conf секрета нет.
# Комплект (install.sh, update.sh) туннель и firewall не настраивает; проверка — bin/host-net-check.sh (только читает).
#
# Подсеть туннеля: предложение 10.77.0.0/24. До выбора проверить, что она не пересекается с сетями Docker
# (`docker network inspect optomstroy_prod_edge optomstroy_prod_backend --format '{{json .IPAM.Config}}'`),
# с маршрутами хоста (`ip route`), с частной сетью провайдера и с локальной сетью магазина (вариант «роутер», ниже).
#
# Адреса в туннеле (предложение, 16 §12.2):
#   10.77.0.1     — сервер POS (этот хост)
#   10.77.0.2     — магазин: компьютер с веб-публикацией 1С (вариант а) или роутер магазина (вариант б)
#   10.77.0.3–.9  — постоянные узлы в КР (NAS для копии вне сервера, хост монитора) — только если заказчик выбрал такое
#                   место (вопросы Q-033, Q-103); облачному хранилищу и арендованному серверу в КР туннель не нужен
#   10.77.0.10+   — администраторы исполнителя (SERVER_REQUIREMENTS §4, способ 1), по одному адресу на человека
# ONEC_BASE_URL в .env: https://10.77.0.2/<база> (вариант а) или https://<LAN-адрес веб-сервера 1С>/<база> (вариант б).

[Interface]
Address = 10.77.0.1/24
# UDP-порт согласуется с заказчиком (в документах — только <WG_PORT>). Тот же порт открыть в firewall хоста
# (RUNBOOK §11.3) и в сетевом фильтре панели провайдера, если он есть.
ListenPort = <WG_PORT>
PostUp = wg set %i private-key /etc/wireguard/server.private
# Запас под LTE/PPPoE в магазине [ТИПОВО]; если большие ответы 1С «зависают», а /health отвечает — уменьшить до 1280
# на обеих сторонах.
MTU = 1380
# Пиры туннеля не видят друг друга через сервер (Docker включает ip_forward; его политика FORWARD — DROP, здесь — явно).
PostUp = iptables -I FORWARD -i %i -o %i -j DROP
PostDown = iptables -D FORWARD -i %i -o %i -j DROP

# --- Магазин (1С) ---
[Peer]
# store-1c: компьютер с веб-публикацией 1С (вариант а, по умолчанию) или роутер магазина (вариант б)
PublicKey = <открытый ключ магазина>
# Вариант а: только адрес компьютера 1С в туннеле.
# Вариант б (роутер без NAT в туннель): добавить через запятую <LAN-адрес веб-сервера 1С>/32 — только этот адрес,
# не всю сеть магазина.
AllowedIPs = 10.77.0.2/32
# Endpoint не задаётся: соединение начинает магазин (исходящий UDP, PersistentKeepalive на его стороне); сервер узнаёт
# адрес магазина из рукопожатия и переезжает за ним при смене IP или переходе на резервный канал (roaming).

# --- Постоянный узел в КР (необязательно) ---
# Только если заказчик выбрал для копии вне сервера NAS в КР (в магазине или другом помещении) или монитор на компьютере
# в КР, который включён круглые сутки (Q-033, Q-103; RUNBOOK §11.8). Облачное хранилище и арендованный сервер в КР
# доступны без туннеля — тогда этот блок не нужен. Узел сам начинает соединение (Endpoint и PersistentKeepalive — у него).
#[Peer]
# kr-node-1: NAS копии вне сервера или хост монитора
#PublicKey = <открытый ключ узла>
#AllowedIPs = 10.77.0.3/32

# --- Администраторы исполнителя (по одному блоку на человека; удалить блок — отозвать доступ) ---
[Peer]
# admin-1
PublicKey = <открытый ключ администратора>
AllowedIPs = 10.77.0.10/32
