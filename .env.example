# .env.example «Оптомстрой POS» (RM-C-009). Канонический перечень — 16_DEPLOYMENT_PLAN §4.3 (таблица и пример).
# Здесь ТОЛЬКО несекретная конфигурация. Секреты — файлы secrets/* (права 640, группа optomstroy-secrets); указатели *_FILE
# на /run/secrets/* задаются в docker-compose.yml (16 §4.4), а не в этом файле. Правила *_FILE и ротации —
# infra/env/README.md. Пустое значение после «=» — переменная обязательна и заполняется при деплое
# (или пуста по умолчанию — см. комментарий). Сверка с 16 §4.3: python -I -X utf8 scripts/check_env_example.py
# У пустой переменной комментарий — отдельной строкой выше: Docker Compose читает `ИМЯ=   # текст` как значение
# «# текст», а не пусто (рабочий шаблон — infra/env/prod.env.example).
# Новая переменная сначала вносится в 16 §4.3 (процедура 13 §5.3), затем сюда.

# --- Общие и платформа ---
# prod | staging | dev
APP_ENV=
# неизменяемый тег optomstroy/api (не latest)
API_TAG=
# неизменяемый тег optomstroy/backup
BACKUP_TAG=
# https://api.<домен> (Q-032); обязательна при staging/prod
PUBLIC_BASE_URL=
LOG_LEVEL=info
TZ=Asia/Bishkek
WORKERS_ENABLED=false                 # D-45: в сервисе worker переопределяется на true (16 §4.4)
APP_READ_ONLY=false                   # true — режим только чтения (503 APP_READ_ONLY; перечень исключений — ADR-083)
# CORS_ALLOWED_ORIGINS — R2 (web-таргет), в R1-пример не входит (граница R1/R2 — 16 §4.3)
OPENAPI_PUBLIC=false                  # true только на тестовом контуре (08 §4.19.2)
# platform=semver через запятую: android=1.2.0,windows=1.2.0 (R0 §18.2 п.12)
MIN_APP_VERSION=
# тот же формат; пусто — заголовок X-Recommended-App-Version не отправляется
RECOMMENDED_APP_VERSION=
CUSTOMER_SELF_SERVICE=true            # ядро §24.2: регистрация клиентов, режим клиента в R1; только env (R0 §19.2)
KIOSK_MODE=false                      # планшет магазина (P-002, ADR-115); от CUSTOMER_SELF_SERVICE не зависит; true в prod — только по письменному разрешению заказчика (DEPLOY-053)
# необязательная: IP/CIDR сети магазина через запятую; пусто — проверки нет
KIOSK_ALLOWED_CIDRS=
RECEIVABLES_MAX_AGE_MIN=60

# --- База данных ---
# optomstroy_prod / optomstroy_test
POSTGRES_USER=
# optomstroy_prod / optomstroy_test
POSTGRES_DB=

# --- Аутентификация, OTP, PIN ---
# kid активного ключа подписи
JWT_KEY_ID=
OTP_HMAC_SECRET_VERSION=1
PIN_PEPPER_VERSION=1
SESSION_IDLE_LOCK_MINUTES=30
AUTH_OTP_TEST_MODE=false              # true допустимо только при APP_ENV=staging|dev
# только staging|dev; в prod — пусто
AUTH_OTP_TEST_PHONES=
# только staging|dev; в prod — пусто
AUTH_OTP_TEST_CODE=
OTP_GLOBAL_PER_MIN=60
OTP_PROVIDER=internal                 # internal | smspro (smspro — только R2, Q-242)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_15M=3
OTP_MAX_SENDS_PER_PHONE_24H=10
OTP_MAX_SENDS_PER_IP_10M=20
OTP_MAX_SENDS_PER_IP_24H=100
OTP_MAX_SENDS_PER_DEVICE_10M=5
OTP_MAX_SENDS_PER_DEVICE_24H=20
OTP_LOCK_AFTER_LOCKED_CODES=3
OTP_PHONE_PAUSE_MINUTES=30
OTP_RESEND_ON_DLR_FAILED=true
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_STAFF_DAYS=7
AUTH_REFRESH_TTL_CUSTOMER_DAYS=30
AUTH_REFRESH_TTL_KIOSK_DAYS=180       # планшет магазина: 180 дней с подключения (Р-22 (а))
AUTH_REFRESH_IDLE_STAFF_HOURS=24
AUTH_REFRESH_IDLE_CUSTOMER_DAYS=14
AUTH_REFRESH_IDLE_KIOSK_DAYS=7        # планшет магазина: 7 дней без связи (Р-22 (а))
AUTH_REFRESH_GRACE_SECONDS=30
AUTH_BACKGROUND_LOCK_MINUTES=5
AUTH_BIO_AUTO_PROMPT=true
AUTH_BIO_ALLOW_WEAK=off               # уровень W Android (ADR-116): off | customer | all; не off в prod — только после T-BIO-026 (16 DEPLOY-055)
AUTH_BIO_WEAK_REAUTH_HOURS=24         # уровень W: PIN или вход по SMS не реже раза в N часов; 1…24
AUTH_WINDOWS_HELLO_KEY=off            # ключ Windows Hello без PIN (ADR-116, W2): off | personal | all; не off в prod — только после T-BIO-031; all — только письменно
AUTH_NOTIFY_OLD_PHONE=false           # Q-038 (платная SMS)
PIN_MIN_LENGTH_STAFF=6
PIN_MAX_ATTEMPTS=5

# --- SMSPro ---
# smspro (prod) | fake (test)
SMS_PROVIDER=
SMSPRO_BASE_URL=https://smspro.nikita.kg/api
# согласуется с SMSPro (Q-029)
SMSPRO_SENDER=
SMSPRO_TEST_FLAG=false                # true только при APP_ENV=staging|dev; при prod — отказ в старте
# SMS_STAGING_ALLOWED_PHONES — условная: только APP_ENV=staging (09 §5.8); в прод-пример не входит
SMSPRO_TIMEOUT_MS=15000
SMSPRO_RETRY_MAX=3
SMSPRO_DLR_MODE=poll                  # poll | push
# SMSPRO_DLR_ALLOWED_IPS — условная: задаётся только при SMSPRO_DLR_MODE=push (16 §4.6)
SMSPRO_BALANCE_POLL_MINUTES=15
SMSPRO_BALANCE_ALERT_SOM=300
SMSPRO_CB_OPEN_MINUTES=5
SMSPRO_DEF_PRECHECK=false
SMS_OTP_TEMPLATE="Kod: {code}. Optomstroy"   # текст — Q-029; ровно одна часть SMS

# --- Регистрация, приглашения, FACE-SCAN ---
INVITATION_TTL_DAYS=30                # Q-141
INVITE_SMS=false
REGISTRATION_SECOND_OTP=false
# FACE_SCAN_MODE / FACE_SCAN_STORE_FRAMES / FACE_SCAN_REQUIRED — R2 (Q-003), в R1-пример не входят

# --- 1С ---
# extension (основной) | odata_only (запасной) | fixtures (запрещён при prod)
# | os_api (существующий HTTP-сервис 1С «ОС_API», только чтение каталога/цен/остатков/фото — ADR-126)
ONEC_MODE=
# https://<хост 1С>/<база> (Q-031)
ONEC_BASE_URL=
ONEC_ODATA_PATH=odata/standard.odata
# hs/<имя> (05_ONEC_INTEGRATION)
ONEC_HS_PATH=
ONEC_TIMEOUT_MS=30000
ONEC_SYNC_CHECK_TIMEOUT_MS=6000       # R0 §19.2
ONEC_SYNC_PAGE_SIZE=1000
ONEC_MAX_CONCURRENCY=2
ONEC_ODATA_WRITE_ENABLED=false
ONEC_INBOUND_ENABLED=false            # true только в сценарии C-2 и только при ONEC_MODE=extension (16 §4.6)
# ONEC_INBOUND_ALLOWED_IPS — условная: обязательна при ONEC_INBOUND_ENABLED=true (05 ONEC-060; пусто — отказ в старте)
MANUAL_ORDER_SLA_MIN=60               # Q-119
# ОС_API (ADR-126) — условные, только при ONEC_MODE=os_api:
#   ONEC_BASE_URL — корень публикации 1С (например http://localhost/uk_main_fr; http:// — только адрес этого сервера),
#   вход — ONEC_USER_FILE / ONEC_PASSWORD_FILE (Basic пользователя публикации), обязательны; QR_PROVIDER=onec — отказ
#   в старте (QR через 1С в ОС_API нет), ONEC_ODATA_WRITE_ENABLED=true — отказ. Запись в 1С (заказы, клиенты,
#   оплаты) в этом режиме выключена: заказы ждут оформления в 1С (NO_WRITE_CHANNEL).
# ONEC_OSAPI_PATH=hs/os/api/v1         # путь HTTP-сервиса от корня публикации
# ONEC_OSAPI_PRICE_TYPES=              # UUID видов цен через запятую; пусто — все не удалённые виды цен
# ONEC_OSAPI_WAREHOUSES=               # UUID складов остатков через запятую; пусто — все склады
# ONEC_OSAPI_POLL_SECONDS=300          # период полной перечитки каталога, цен и остатков, с (60…3600, кратно 60)

# --- Синхронизация (значения по умолчанию; переопределение — app_settings.sync_interval.<entity>) ---
SYNC_STOCK_CRON="*/10 * * * *"
SYNC_PRICES_CRON="*/15 * * * *"
SYNC_ORDER_STATUS_CRON="*/5 * * * *"
SYNC_MASTER_CRON="*/30 * * * *"
SYNC_IMAGES_CRON="30 2 * * *"
SYNC_RECONCILE_CRON="0 4 * * 0"
SYNC_NIGHT_WINDOW=01:00-06:00
SALES_HISTORY_MONTHS=12
SYNC_COUNT_CHECK_CRON="30 3 * * *"    # сверка odata_only + добор sent→confirmed; не пересекается с BACKUP_SCHEDULE
SYNC_ALERT_UNREACHABLE_MIN=10         # 05 SYNC-038
OUTBOX_MAX_ATTEMPTS=20                # ядро §22.1 (Q-176); график повторов фиксирован, не env
OUTBOX_MAX_AGE_HOURS=24               # ядро §22.1 (Q-176)

# --- Платежи, долги, возвраты ---
DEBT_PAYMENTS_FROM_POS=false          # Q-152
RETURNS_FROM_POS_ENABLED=false        # только outbox заявок на возврат в 1С (ядро §21 п.1)
QR_PROVIDER=onec                      # onec (QR через 1С) | none (статический QR, ручное подтверждение) | bank (QR от банка через наш сервер, ADR-123; bakai — устаревший синоним)
QR_ONEC_POLL_SECONDS=5                # опрос статуса QR у 1С (только QR_PROVIDER=onec)
QR_TTL_MINUTES=15                     # при onec действует expiresAt из ответа 1С
QR_WEBHOOK_ENABLED=false              # true — только QR_PROVIDER=bank; при onec/none — отказ в старте (11 SEC-135); без QR_WEBHOOK_SECRET_FILE — отказ
# QR_WEBHOOK_ALLOWED_IPS — только при QR_PROVIDER=bank и QR_WEBHOOK_ENABLED=true (песочница банка шлёт вебхук с 127.0.0.1)
# QR_WEBHOOK_SECRET_FILE=/run/secrets/qr_webhook_secret — секрет подписи вебхука (файл вне репозитория)
# BANK_QR_ADAPTER=sandbox — только при QR_PROVIDER=bank: песочница банка; при APP_ENV=prod — отказ в старте (ADR-123)
# BANK_QR_API_BASE_URL, BANK_QR_MERCHANT_ID, BANK_QR_API_KEY_FILE — адаптер настоящего банка [НЕ ПОДТВЕРЖДЕНО: Q-381, Q-382]

# --- Фото ---
MEDIA_DIR=/data/media
MEDIA_MAX_SOURCE_PX=1600

# --- Резервное копирование ---
BACKUP_KEEP_DAYS=30
# имя remote rclone, например offsite:
BACKUP_REMOTE=
BACKUP_SCHEDULE="0 3 * * *"
# публичный получатель age (age1...)
BACKUP_AGE_RECIPIENT=
# BACKUP_AGE_IDENTITY_FILE — НЕ на сервере (машина восстановления, офлайн у заказчика)
