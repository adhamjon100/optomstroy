# Монорепозиторий «Оптомстрой POS» (RM-C-001). Структура — docs/repo_layout.md.
# Правила шаблона Flutter сохранены; пути, привязанные к корню, перенесены в /pos-app/.

# ---------------------------------------------------------------------------
# Секреты — никогда не попадают в git (CONTRIBUTING.md §1 п. 7; 16 §4.3: только *_FILE вне git).
# Проверка: python scripts/check_secrets.py
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/secrets/
*.pfx
*.p12
*.pem
*.key
*.keystore
*.jks
key.properties
**/google-services.json
**/GoogleService-Info.plist
# Выгрузки базы 1С (персональные и коммерческие данные) — не хранятся в git (onec-extension/README.md)
*.dt
*.1CD

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
*.class
*.log
!docs/stages/*.log
*.pyc
__pycache__/
*.swp
.DS_Store
Thumbs.db
# Файлы-замки Microsoft Office (~$имя.docx): в них имя учётной записи того, кто открыл документ
~$*
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ---------------------------------------------------------------------------
# Flutter/Dart/Pub related (pos-app/)
# ---------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/pos-app/build/
/pos-app/coverage/
/pos-app/packages/*/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/pos-app/android/app/debug
/pos-app/android/app/profile
/pos-app/android/app/release

# ---------------------------------------------------------------------------
# Node (pos-api/, tools/) — lock-файлы коммитятся
# ---------------------------------------------------------------------------
node_modules/
/pos-api/dist/
/pos-api/coverage/
npm-debug.log*
.npm/

# tools/pg — одноразовый PostgreSQL 17 (embedded-postgres): зависимости и временные кластеры
/tools/pg/node_modules/
/tools/pg/.tmp/

# Временные файлы тестов (embedded PostgreSQL, flutter) — на диске D:, чтобы не занимать C:
/.tmp/

# Демо-пакет: собранное приложение, данные и журналы (demo/build-demo.ps1)
/demo/app/
/demo/data/
/demo/logs/
/demo/.tmp/
/demo/demo_env.json

# Веб-демо на Netlify (ADR-113): собранный сайт, промежуточная сборка, снимки headless-проверки (demo/web/build-web-demo.ps1)
/demo/web/site/
/demo/web/.build/
/demo/web/.smoke/
.netlify/
