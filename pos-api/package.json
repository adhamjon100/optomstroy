{
  "name": "pos-api",
  "version": "0.1.0",
  "description": "Optomstroy POS backend: модульный монолит NestJS (pos-api / pos-worker), RM-C-005",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit && eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"scripts/**/*.mjs\" && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:db": "vitest run --config ./test/db/vitest.config.ts",
    "test:worker": "vitest run --config ./test/worker/vitest.config.ts",
    "test:integrations": "vitest run --config ./test/integrations/vitest.config.ts",
    "test:foundation": "vitest run --config ./test/foundation/vitest.config.ts",
    "test:auth": "vitest run --config ./test/auth/vitest.config.ts",
    "test:admin": "vitest run --config ./test/admin/vitest.config.ts",
    "test:customers": "vitest run --config ./test/customers/vitest.config.ts",
    "test:profile": "vitest run --config ./test/profile/vitest.config.ts",
    "test:registration": "vitest run --config ./test/registration/vitest.config.ts",
    "test:settings": "vitest run --config ./test/settings/vitest.config.ts",
    "test:sms": "vitest run --config ./test/sms/vitest.config.ts",
    "test:onec": "vitest run --config ./test/onec/vitest.config.ts",
    "test:sync-apply": "vitest run --config ./test/sync-apply/vitest.config.ts",
    "test:search": "vitest run --config ./test/search/vitest.config.ts",
    "bench:search": "tsx test/search/bench/search-bench.ts",
    "test:catalog-sync": "vitest run --config ./test/catalog-sync/vitest.config.ts",
    "test:favorites": "vitest run --config ./test/favorites/vitest.config.ts",
    "test:sync": "vitest run --config ./test/sync/vitest.config.ts",
    "test:catalog": "vitest run --config ./test/catalog/vitest.config.ts",
    "test:images": "vitest run --config ./test/images/vitest.config.ts",
    "test:sales-domain": "vitest run --config ./test/sales-domain/vitest.config.ts",
    "test:cart": "vitest run --config ./test/cart/vitest.config.ts",
    "test:payments": "vitest run --config ./test/payments/vitest.config.ts",
    "test:orders": "vitest run --config ./test/orders/vitest.config.ts",
    "test:documents": "vitest run --config ./test/documents/vitest.config.ts",
    "test:notifications": "vitest run --config ./test/notifications/vitest.config.ts",
    "test:cashier-foundation": "vitest run --config ./test/cashier-foundation/vitest.config.ts",
    "test:receivables": "vitest run --config ./test/receivables/vitest.config.ts",
    "test:discounts": "vitest run --config ./test/discounts/vitest.config.ts",
    "test:cov:credit": "vitest run --coverage --config ./test/receivables/vitest.config.cov.ts",
    "test:transactions": "vitest run --config ./test/transactions/vitest.config.ts",
    "test:returns": "vitest run --config ./test/returns/vitest.config.ts",
    "test:reports": "vitest run --config ./test/reports/vitest.config.ts",
    "test:customer-mode": "vitest run --config ./test/customer-mode/vitest.config.ts",
    "audit:verify": "tsx scripts/verify_audit_chain.ts",
    "seed:catalog": "tsx scripts/seed_synthetic_catalog.ts",
    "test:all": "npm test && npm run test:integrations && npm run test:worker && npm run test:db && npm run test:foundation && npm run test:auth && npm run test:admin && npm run test:customers && npm run test:profile && npm run test:registration && npm run test:settings && npm run test:sms && npm run test:onec && npm run test:sync-apply && npm run test:sync && npm run test:catalog && npm run test:catalog-sync && npm run test:favorites && npm run test:search && npm run test:images && npm run test:sales-domain && npm run test:cart && npm run test:payments && npm run test:orders && npm run test:documents && npm run test:notifications && npm run test:cashier-foundation && npm run test:receivables && npm run test:discounts && npm run test:transactions && npm run test:returns && npm run test:reports && npm run test:customer-mode && npm run test:e2e",
    "test:e2e:catalog": "npm run build && vitest run --config ./test/e2e/catalog/vitest.config.process.ts",
    "stack:catalog-smoke": "node scripts/local-stack.mjs catalog-smoke",
    "test:e2e:pos": "npm run build && vitest run --config ./test/e2e/pos/vitest.config.process.ts",
    "stack:pos-smoke": "node scripts/local-stack.mjs pos-smoke",
    "test:e2e:cashier": "npm run build && vitest run --config ./test/e2e/cashier/vitest.config.process.ts",
    "stack:cashier-smoke": "node scripts/local-stack.mjs cashier-smoke",
    "load:catalog-fixtures": "tsx scripts/load_catalog_fixtures.ts",
    "onec:acceptance": "tsx scripts/onec_acceptance.ts",
    "onec:reregister": "tsx scripts/onec_reregister.ts",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/migrate.js --seed",
    "worker": "node dist/worker.js",
    "madge": "madge --circular --extensions ts src",
    "gen:enums": "python -I -X utf8 ../scripts/gen_enums.py --out src/common && node scripts/drop-dart-enums.mjs",
    "gen:permissions": "node scripts/gen-permissions.mjs",
    "check:permissions": "node scripts/gen-permissions.mjs --check",
    "test:cov:d": "vitest run --coverage --config ./vitest.config.cov-d.ts",
    "test:cov:e": "vitest run --coverage --config ./vitest.config.cov-e.ts",
    "test:cov:f": "vitest run --coverage --config ./vitest.config.cov-f.ts",
    "test:cov:g": "vitest run --coverage --config ./vitest.config.cov-g.ts",
    "test:cov:all": "vitest run --coverage --config ./vitest.config.cov-all.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "libphonenumber-js": "1.13.15",
    "nestjs-pino": "5.3.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "madge": "8.0.0",
    "pdf-parse": "2.4.5",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    }
  }
}
